# Copy to .env on the Linux host; chmod 600. Never commit actual values.
POSTGRES_IMAGE=docker.io/library/postgres:17.11-alpine3.24@sha256:aa90e97ee862e558111d34cfb8b2c4bec768c2b039fb791341686928560263b3
DIRECTUS_IMAGE=docker.io/directus/directus:11.17.4@sha256:304e86483c3f44ceb0b90a1227104f165774483d157da145b4382d9c35b56b0b
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.9.3@sha256:2fa795d0271a71c133a8f17c19a2a625e1976ad716329e0e61789f9fd8ee0091
POSTGRES_PASSWORD=GENERATE_LONG_RANDOM_VALUE
INTAKE_DB_PASSWORD=GENERATE_DIFFERENT_LONG_RANDOM_VALUE
DIRECTUS_SECRET=GENERATE_64_RANDOM_CHARACTERS
ADMIN_EMAIL=SET_TO_A_VALID_ADMIN_EMAIL
ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
DIRECTUS_PRIVATE_URL=https://YOUR-HOST.YOUR-TAILNET.ts.net
CLOUDFLARE_TUNNEL_TOKEN=FROM_CLOUDFLARE_ZERO_TRUST_DASHBOARD
INTAKE_IMAGE=ghcr.io/ohgeeceee/network-intake:stable
