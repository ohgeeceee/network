# Copy to .env on the Linux host; chmod 600. Never commit actual values.
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
DIRECTUS_IMAGE=directus/directus:11@sha256:REPLACE_WITH_REVIEWED_DIGEST
CLOUDFLARED_IMAGE=cloudflare/cloudflared:REPLACE_WITH_VERSION@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_PASSWORD=GENERATE_LONG_RANDOM_VALUE
INTAKE_DB_PASSWORD=GENERATE_DIFFERENT_LONG_RANDOM_VALUE
DIRECTUS_SECRET=GENERATE_64_RANDOM_CHARACTERS
DIRECTUS_PRIVATE_URL=https://YOUR-HOST.YOUR-TAILNET.ts.net
CLOUDFLARE_TUNNEL_TOKEN=FROM_CLOUDFLARE_ZERO_TRUST_DASHBOARD
INTAKE_IMAGE=ghcr.io/ohgeeceee/network-intake:stable
